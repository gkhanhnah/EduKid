MONGO_URI=mongodb://127.0.0.1:27017/edukid
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated origins for Socket.IO (Vite default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# OpenRouter — https://openrouter.ai/keys (value only, no "Bearer ")
# Server loads this file from the Server/ folder even if you start node from elsewhere.
AI_API_KEY=
# Optional alias (same value as AI_API_KEY if you prefer this name)
# OPENROUTER_API_KEY=
# Optional. Default: mistralai/mistral-7b-instruct-v0.2 (mistralai/mistral-7b-instruct often has no endpoints)
# AI_MODEL=mistralai/mistral-7b-instruct-v0.2
